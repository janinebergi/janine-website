# Kopiere diese Datei nach .env.local (lokal) bzw. hinterlege die Werte in Vercel
# unter Project → Settings → Environment Variables.

# Passwort für den Login unter /admin. Frei wählbar, bitte sicher aufbewahren.
ADMIN_PASSWORD=

# GitHub-Zugang zum Speichern auf der Live-Seite.
# Fine-grained Personal Access Token mit Berechtigung
#   "Contents: Read and write" für das Repository janinebergi/janine-website.
# Erstellen: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Optional – nur ändern, wenn Repo/Branch abweichen.
# GITHUB_REPO=janinebergi/janine-website
# GITHUB_BRANCH=main
